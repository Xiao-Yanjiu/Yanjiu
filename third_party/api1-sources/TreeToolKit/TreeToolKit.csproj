<Project Sdk="Dalamud.CN.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <DalamudApiLevel>15</DalamudApiLevel>
    <AssemblyName>TreeToolKit</AssemblyName>
    <RootNamespace>TreeToolKit</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Use_DalamudPackager>false</Use_DalamudPackager>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <NoWarn>$(NoWarn);Dalamud001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TreeTools\TreeTools.csproj" />
    <ProjectReference Include="..\KamiToolKit\KamiToolKit.csproj" />
    <ProjectReference Include="..\OmenTools\OmenTools.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DailyRoutines.CodeAnalysis" Version="2.6.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.5" />
  </ItemGroup>
</Project>
